# Booking -- paste a Calendly, Cal.com, or Google Calendar scheduling link.
# Example: https://cal.com/webworkers/intro-call
VITE_BOOKING_URL=

# Direct contact channels shown in the Contact section and footer.
VITE_WHATSAPP_URL=
VITE_EMAIL=
VITE_LINKEDIN_URL=

# Endpoint the contact form POSTs to (Formspree, Resend proxy, Supabase
# function, custom API route, etc). Left blank, the form stays in a
# clearly-labeled "not connected yet" state instead of faking success.
VITE_CONTACT_API_URL=
